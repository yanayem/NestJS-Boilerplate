{
  "name": "nestjs-mongodb-saas-boilerplate",
  "version": "1.0.0",
  "description": "Production-ready NestJS + MongoDB SaaS Boilerplate with Auth, RBAC, File Upload, Mail, Payment, and Rate Limiting",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build:frontend": "cross-env NODE_ENV=production next build",
    "build:backend": "nest build",
    "build": "npm run build:frontend && npm run build:backend",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/main",
    "dev:backend": "nest start --watch",
    "dev:frontend": "next dev -p 3000",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start:dev": "npm run dev",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^7.1.0",
    "@nestjs/throttler": "^5.0.0",
    "aws-sdk": "^2.1400.0",
    "axios": "^1.20.0",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cross-env": "^10.1.0",
    "helmet": "^7.0.0",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.70.0",
    "mongoose": "^7.3.0",
    "next": "^15.1.0",
    "nodemailer": "^6.9.3",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "stripe": "^12.13.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/turbopack": "^4",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.17",
    "@types/js-cookie": "^3.0.6",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^6.4.8",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^3.0.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.5.32",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "tailwindcss": "^4",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
